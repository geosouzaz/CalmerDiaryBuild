<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Modo escuro: vinho mais suave sobre fundos escuros e confortáveis -->
    <style name="Theme.CalmerDiary" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/wine_primary_light</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/wine_primary_dark</item>
        <item name="colorOnPrimaryContainer">@color/text_dark</item>

        <item name="colorSecondary">@color/wine_accent</item>
        <item name="colorOnSecondary">@color/white</item>

        <item name="android:colorBackground">@color/background_dark</item>
        <item name="colorOnBackground">@color/text_dark</item>
        <item name="colorSurface">@color/surface_dark</item>
        <item name="colorOnSurface">@color/text_dark</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary_dark</item>
        <item name="colorOutline">@color/outline_dark</item>

        <item name="android:statusBarColor">@color/background_dark</item>
        <item name="android:navigationBarColor">@color/background_dark</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">false</item>
    </style>
</resources>
