<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_md"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/surface_translucent_dark"
    app:cardCornerRadius="@dimen/corner_lg"
    app:cardElevation="0dp"
    app:rippleColor="@color/wine_accent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:padding="@dimen/space_md">

        <!-- Bloco de data -->
        <LinearLayout
            android:layout_width="62dp"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvDay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                android:textSize="26sp"
                android:textStyle="bold"
                tools:text="18" />

            <TextView
                android:id="@+id/tvMonthYear"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_secondary_dark"
                android:textSize="11sp"
                tools:text="set., 2026" />

            <TextView
                android:id="@+id/tvWeekday"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_secondary_dark"
                android:textSize="11sp"
                tools:text="sexta-feira" />
        </LinearLayout>

        <!-- Título + resumo -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_md"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/white"
                android:textSize="17sp"
                android:textStyle="bold"
                tools:text="sexta desanimada que só :(" />

            <TextView
                android:id="@+id/tvSnippet"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/text_secondary_dark"
                android:textSize="14sp"
                tools:text="Hoje já começou eu percebendo que minha cachorrinha…" />

            <ImageView
                android:id="@+id/ivThumb"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:layout_marginTop="@dimen/space_sm"
                android:adjustViewBounds="true"
                android:contentDescription="@string/cd_entry_image"
                android:scaleType="centerCrop"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Humor -->
        <TextView
            android:id="@+id/tvMood"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_sm"
            android:contentDescription="@string/cd_entry_mood"
            android:textSize="24sp"
            tools:text="😔" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
