<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingVertical="@dimen/space_sm">

    <TextView
        android:id="@+id/tvAchEmoji"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:background="@drawable/bg_ach_circle"
        android:gravity="center"
        android:textSize="24sp"
        tools:text="🎨" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_md"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvAchTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            tools:text="Paleta Colorida" />

        <TextView
            android:id="@+id/tvAchDesc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_secondary_dark"
            android:textSize="13sp"
            tools:text="Registre 6 humores diferentes" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progressAch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            app:indicatorColor="@color/wine_accent"
            app:trackColor="#33FFFFFF"
            app:trackCornerRadius="4dp"
            app:trackThickness="6dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvAchPercent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_sm"
        android:textColor="@color/wine_accent"
        android:textSize="14sp"
        android:textStyle="bold"
        tools:text="67%" />

</LinearLayout>
